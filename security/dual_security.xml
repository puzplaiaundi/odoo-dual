<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_formacion_dual" model="ir.module.category">
        <field name="name">Formación Dual</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_dual_user" model="res.groups">
        <field name="name">Usuario Dual</field>
        <field name="category_id" ref="gestion_dual.module_category_formacion_dual"/>
    </record>

    <record id="group_dual_manager" model="res.groups">
        <field name="name">Responsable Dual</field>
        <field name="category_id" ref="gestion_dual.module_category_formacion_dual"/>
        <field name="implied_ids" eval="[(4, ref('gestion_dual.group_dual_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('gestion_dual.group_dual_manager'))]"/>
    </record>
</odoo>
