<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_inherit_gestion_dual" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.gestion.dual</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Candidaturas" invisible="type != 'opportunity'">
                    <field name="dual_candidatura_ids" context="{'default_oportunidad_id': id}">
                        <tree string="Candidaturas">
                            <field name="alumno_id"/>
                            <field name="estado_id" optional="show"/>
                            <field name="create_date" optional="show" readonly="1" string="Fecha de creación"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
